   "inputCheck": "def valid(times):\n    if not isinstance(times, list) or not (1 <= len(times) <= 100):\n        return False\n    def sec(s):\n        if not isinstance(s, str) or len(s) != 8 or s[2] != ':' or s[5] != ':':\n            return None\n        parts = [s[0:2], s[3:5], s[6:8]]\n        if not all(c in '0123456789' for p in parts for c in p):\n            return None\n        h, m, x = [int(p) for p in parts]\n        if not (10 <= h <= 23 and 0 <= m <= 59 and 0 <= x <= 59):\n            return None\n        return h * 3600 + m * 60 + x\n    for t in times:\n        if not isinstance(t, list) or len(t) != 2:\n            return False\n        a, b = sec(t[0]), sec(t[1])\n        if a is None or b is None or a > b:\n            return False\n    return True",
