   "solution": "def func_a(arr):\n    ret = [0, 0]\n    for x in arr:\n        if x >= 0:\n            ret[0] += x\n        else:\n            ret[1] += x\n    return ret\n\ndef func_b(arr):\n    ret = arr[0] - arr[1]\n    if ret < 0:\n        return -ret\n    else:\n        return ret\n\ndef func_c(arr):\n    ret = []\n    for a in arr:\n        ret.append(sum(a))\n    return ret\n\ndef solution(arr2d):\n    arr = func_c(arr2d)  # 행의 합\n    vnum = func_a(arr)  # 양수끼리, 음수끼리 더하기\n    num = func_b(vnum)  # 두 수의 차이\n    return num",
