   "inputCheck": "def valid(N, info, game):\n    def ok_ids(xs):\n        return isinstance(xs, list) and len(set(xs)) == len(xs) and all(type(x) is int and 1 <= x <= N - 1 for x in xs)\n    if not (type(N) is int and 2 <= N <= 50):\n        return False\n    if not (isinstance(info, list) and len(info) == 2 and isinstance(info[0], list) and len(info[0]) == 1):\n        return False\n    k = info[0][0]\n    if not (type(k) is int and 1 <= k <= N - 1):\n        return False\n    if not (ok_ids(info[1]) and len(info[1]) == k):\n        return False\n    if not (isinstance(game, list) and 1 <= len(game) <= 50):\n        return False\n    return all(isinstance(g, list) and 1 <= len(g) <= N - 1 and ok_ids(g) for g in game)",
